{
  "name": "Bench Atlas",
  "short_name": "Bench Atlas",
  "description": "Track fly tying materials, storage spots, recipe ingredients, and rebuy items from one mobile-friendly app.",
  "start_url": "/#atlas",
  "scope": "/",
  "display": "standalone",
  "background_color": "#efe7da",
